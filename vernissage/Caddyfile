# HTTPS for Vernissage's API at $API_DOMAIN. Requests arrive through Vercel
# (which already set X-Forwarded-For) or, for the live rooms' WebSocket,
# straight from the browser. Caddy normally replaces an X-Forwarded-For it
# does not trust, which would make every visitor look like a Vercel edge
# server; trusting it makes Caddy append instead, and the server, told there
# are two hops, picks the visitor's address out of the chain. A client that
# calls the API directly can therefore choose the address it is rate-limited
# under, the same as behind any appending proxy.
{
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy server:8790
}

# noctiluca's backend. The same two hops as above: the Vercel site's rewrite
# and Caddy; the live sea's WebSocket comes straight from the browser.
{$NOCTILUCA_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy noctiluca:8000
}

# kori's demo page, and its API with the demo key attached. A visitor's own
# Authorization header is replaced, so the only credential in play is a key
# whose scopes allow reading accounts, reading and posting transfers, and
# verifying the ledger: no new accounts, no admin. Everything else on the
# API (metrics, health) is not reachable from here.
{$KORI_DOMAIN} {
	encode zstd gzip
	header -Server
	handle /v1/* {
		reverse_proxy kori:3000 {
			header_up Authorization "ApiKey {$KORI_DEMO_KEY}"
		}
	}
	handle {
		root * /srv/home/kori
		file_server
	}
}

# quill speaks the PostgreSQL protocol on port 15433, not HTTP; this page
# says how to connect.
{$QUILL_DOMAIN} {
	encode zstd gzip
	header -Server
	root * /srv/home/quill
	file_server
}

# Logarithm Warehouse: its own Nginx load balancer serves the dashboard and
# routes /orders and /inventory to the two services.
{$WAREHOUSE_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy nginx:80
}

# Its Grafana, open to read; changing anything needs the admin password.
{$GRAFANA_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy grafana:3000
}

# Sandglass's match server: the game's WebSocket at /ws, plus /stats and
# /healthz. Caddy upgrades the WebSocket itself; no compression on a socket.
{$SANDGLASS_DOMAIN} {
	header -Server
	reverse_proxy sandglass:7350
}
